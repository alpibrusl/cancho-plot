    same(heap, chart_of(heap, "x,y\n0,0\n1,1\n", "y", 20, 8, "", false, false, 0, 0.0, 0, 0.0, 1, 3.0, 4.0, 0), "4 |::::::::::::::::::::\n  |::::::::::::::::::::\n3 |::::::::::::::::::::\n  |\n2 |\n  |\n1 |                   *\n0 |*\n  +--------------------\n   0.0    0.4 0.6 0.8\n* y\n");
