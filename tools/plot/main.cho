edition 9;

// `plot` -- plots as a command line (docs/design.md). Built so far:
//
//     plot ticks LO HI [N]     the nice ticks of the range [LO, HI] aimed at N intervals (default 5), one label a line
//     plot --x COL --y COL[,COL..] [--with points|lines] [--term dumb|svg] [--size WxH] [--title TEXT]
//                          [--vline X,..] [--hline Y,..] [--band LO,HI].. [--diag] [--yerr COL,.. | --ylo COL,.. --yhi COL,..] [--xhi COL] [--curve ecdf|roc|qq] [--logy] [--by COL] [--json PATH] < table.csv     a chart (docs/design.md sections 11, 13 and 15)
//
// A refusal prints nothing on standard output and, on standard error, one JSON line `{"error":"plot.<rule>","message":"...","repair":"..."}`; exit status 2.
// Authority: arguments, standard input, standard output and standard error; no file, no network, no clock.

import plot.by;
import plot.chart;
import plot.curve;
import plot.jsontable;
import plot.num;
import plot.ticks;
import std.buffer;
import std.bytes;
import std.io;

fn refuse[&i](io: &!i Io, rule: &static [byte], message: &static [byte], repair: &static [byte]) -> [err_write] int {
    let a = io.error_all(io, "{\"error\":\"");
    let b = io.error_all(io, rule);
    let c = io.error_all(io, "\",\"message\":\"");
    let d = io.error_all(io, message);
    let e = io.error_all(io, "\",\"repair\":\"");
    let f = io.error_all(io, repair);
    let g = io.error_all(io, "\"}\n");
    return 2;
}

// a refusal that says which line of the table it is about
fn refuse_line[&h, &i](heap: &!h Heap, io: &!i Io, rule: &static [byte], message: &static [byte], repair: &static [byte], line: int) -> [heap, err_write] int {
    var tail = buffer.append(heap, buffer.empty(heap, 64), "\",\"line\":");
    tail = buffer.push_nat(heap, tail, line);
    tail = buffer.append(heap, tail, "}\n");
    let a = io.error_all(io, "{\"error\":\"");
    let b = io.error_all(io, rule);
    let c = io.error_all(io, "\",\"message\":\"");
    let d = io.error_all(io, message);
    let e = io.error_all(io, "\",\"repair\":\"");
    let f = io.error_all(io, repair);
    borrow tail as &tb in {
        let g = io.error_all(io, buffer.bytes(tb));
    }
    buffer.drop(heap, tail);
    return 2;
}

fn do_ticks[&h, &i, &g](heap: &!h Heap, io: &!i Io, args: &g Args) -> [heap, io_write, err_write, args] int {
    if arg_count(args) < 4 || arg_count(args) > 5 {
        return refuse(io, "plot.usage", "ticks takes LO HI and optionally N", "plot ticks 0 10 5");
    }
    let (lo_ok, lo) = num.number(arg(args, 2));
    let (hi_ok, hi) = num.number(arg(args, 3));
    if !lo_ok || !hi_ok {
        return refuse(io, "plot.not-numeric", "LO and HI must be numbers", "write them as decimals: 0 or -2.5 or 1e3");
    }
    var n = 5;
    if arg_count(args) == 5 {
        n = num.natural(arg(args, 4));
        if n < 1 || n > 100 {
            return refuse(io, "plot.range-invalid", "N must be a whole number from 1 to 100", "plot ticks 0 10 5");
        }
    }
    if !(lo < hi) {
        return refuse(io, "plot.range-invalid", "LO must be less than HI", "swap them, or widen the range");
    }
    // what the ticks can stand for: tick numbers are integers and powers of ten up to 10^22 are exact (docs/design.md section 5)
    let span = hi - lo;
    var far = hi;
    if 0.0 - lo > far {
        far = 0.0 - lo;
    }
    if far > 1.0e15 || span < 1.0e-12 || far / span > 1.0e12 {
        return refuse(io, "plot.range-invalid", "the range must lie within 1e15 of zero, be at least 1e-12 wide, and be no more than 1e12 times narrower than its distance from zero", "plot the difference from a base value, or rescale the data");
    }
    let (m, e) = ticks.step(span, n);
    let (first, last) = ticks.range(lo, hi, m, e);
    var out = buffer.empty(heap, 256);
    var k = first;
    while k <= last {
        out = ticks.label(heap, out, k, m, e);
        out = buffer.push(heap, out, byte_of(10));
        k = k + 1;
    }
    borrow out as &ob in {
        let w = buffer.write(io, ob);
    }
    buffer.drop(heap, out);
    return 0;
}

// the whole of standard input, up to 16 MiB: (text, whether there was more)
fn read_all[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] (buffer.Buffer, bool) {
    var all = buffer.empty(heap, 65536);
    var going = true;
    var big = false;
    while going {
        all = buffer.reserve(heap, all, 65536);
        borrow mut all as &!aw in {
            match read_bytes(io, buffer.room(aw)) {
                Read::Got(n) => {
                    buffer.filled(aw, n);
                }
                Read::End => {
                    going = false;
                }
                Read::Failed(reason) => {
                    going = false;
                }
            }
        }
        var held = 0;
        borrow all as &hb in {
            held = buffer.size(hb);
        }
        if held > 16777216 {
            big = true;
            going = false;
        }
    }
    return (all, big);
}

// "WxH" as (w, h), or (-1, -1)
fn size_of[&s](text: &s [byte]) -> [] (int, int) {
    var at = 0 - 1;
    var k = 0;
    while k < len(text) {
        if int_of(text[k]) == 'x' {
            at = k;
        }
        k = k + 1;
    }
    if at < 0 {
        return (0 - 1, 0 - 1);
    }
    return (num.natural(text[0..at]), num.natural(text[at + 1..len(text)]));
}

// the numbers of the comma-separated `text`, written into `ann` from position `at`: how many there are, or -1 when one is not a number, -2 when there are more than `room`
fn read_list[&s, &a](text: &s [byte], ann: &!a [float], at: int, room: int) -> [] int {
    var count = 0;
    var start = 0;
    var k = 0;
    while k <= len(text) {
        if k == len(text) || int_of(text[k]) == ',' {
            let (ok, v) = num.number(text[start..k]);
            if !ok {
                return 0 - 1;
            }
            if count >= room {
                return 0 - 2;
            }
            ann[at + count] = v;
            count = count + 1;
            start = k + 1;
        }
        k = k + 1;
    }
    return count;
}

fn do_chart[&h, &i, &g](heap: &!h Heap, io: &!i Io, args: &g Args) -> [heap, io_read, io_write, err_write, args] int {
    var status = 2;
    region r {
        let ann = alloc_slice[r](24, 0.0);
        let ac = alloc_slice[r](9, 0);
        status = do_chart_with(heap, io, args, ann, ac);
    }
    return status;
}

fn do_chart_with[&h, &i, &g, &a, &c](heap: &!h Heap, io: &!i Io, args: &g Args, ann: &!a [float], ac: &!c [int]) -> [heap, io_read, io_write, err_write, args] int {
    var xspec = "";
    var yspec = "";
    var yerr = "";
    var yhi = "";
    var xhi = "";
    var json_path = "";
    var use_json = false;
    var title = "";
    var has_title = false;
    var sw = 0 - 1;
    var sh = 0 - 1;
    var svg_term = false;
    var lines = false;
    var curve_kind = 0;
    var by_spec = "";
    var use_by = false;
    var k = 1;
    var seen_x = false;
    var seen_y = false;
    while k < arg_count(args) {
        let flag = arg(args, k);
        if bytes.equal(flag, "--diag") {
            ac[3] = 1;
            k = k + 1;
        } else if bytes.equal(flag, "--logy") {
            ac[8] = 1;
            k = k + 1;
        } else if bytes.equal(flag, "--categories") {
            ac[7] = 1;
            k = k + 1;
        } else {
            if k + 1 >= arg_count(args) {
                return refuse(io, "plot.usage", "a flag needs a value", "plot --x COL --y COL[,COL..] [--size WxH] [--title TEXT] [--term dumb]");
            }
            let value = arg(args, k + 1);
            if bytes.equal(flag, "--x") {
                xspec = value;
                seen_x = true;
            } else if bytes.equal(flag, "--y") {
                yspec = value;
                seen_y = true;
            } else if bytes.equal(flag, "--yerr") {
                if ac[6] == 1 {
                    return refuse(io, "plot.usage", "--yerr or --ylo with --yhi, not both", "--yerr e, or --ylo l --yhi h");
                }
                yerr = value;
            } else if bytes.equal(flag, "--ylo") {
                if ac[6] == 0 && len(yerr) > 0 {
                    return refuse(io, "plot.usage", "--yerr or --ylo with --yhi, not both", "--yerr e, or --ylo l --yhi h");
                }
                yerr = value;
                ac[6] = 1;
            } else if bytes.equal(flag, "--yhi") {
                yhi = value;
            } else if bytes.equal(flag, "--xhi") || bytes.equal(flag, "--z") {
                xhi = value;
            } else if bytes.equal(flag, "--by") {
                by_spec = value;
                use_by = true;
            } else if bytes.equal(flag, "--curve") {
                if bytes.equal(value, "ecdf") {
                    curve_kind = 1;
                } else if bytes.equal(value, "roc") {
                    curve_kind = 2;
                } else if bytes.equal(value, "qq") {
                    curve_kind = 3;
                } else {
                    return refuse(io, "plot.usage", "--curve takes ecdf, roc or qq", "--curve roc --x label --y score");
                }
            } else if bytes.equal(flag, "--json") {
                json_path = value;
                use_json = true;
            } else if bytes.equal(flag, "--title") {
                if len(value) > 200 {
                    return refuse(io, "plot.usage", "the title is longer than 200 bytes", "shorten it");
                }
                title = value;
                has_title = true;
            } else if bytes.equal(flag, "--term") {
                if bytes.equal(value, "svg") {
                    svg_term = true;
                } else if bytes.equal(value, "dumb") {
                    svg_term = false;
                } else {
                    return refuse(io, "plot.usage", "the terminals are dumb and svg", "--term svg");
                }
            } else if bytes.equal(flag, "--vline") || bytes.equal(flag, "--hline") {
                var at = 0;
                var slot = 0;
                if bytes.equal(flag, "--hline") {
                    at = 8;
                    slot = 1;
                }
                if ac[slot] > 0 {
                    return refuse(io, "plot.usage", "a flag is given once", "list the values with commas: --vline 3,9");
                }
                let c = read_list(value, ann, at, 8);
                if c == 0 - 1 {
                    return refuse(io, "plot.not-numeric", "a marker value is not a number", "--vline 35 or --hline 1.25");
                }
                if c == 0 - 2 {
                    return refuse(io, "plot.usage", "at most 8 values for --vline or --hline", "plot fewer markers");
                }
                ac[slot] = c;
            } else if bytes.equal(flag, "--band") {
                if ac[2] >= 4 {
                    return refuse(io, "plot.usage", "at most 4 --band", "plot fewer bands");
                }
                let c = read_list(value, ann, 16 + 2 * ac[2], 2);
                if c == 0 - 1 {
                    return refuse(io, "plot.not-numeric", "a band end is not a number", "--band LO,HI");
                }
                if c != 2 {
                    return refuse(io, "plot.usage", "--band takes two numbers, LO,HI", "--band 1.0,1.5");
                }
                if ann[16 + 2 * ac[2]] > ann[17 + 2 * ac[2]] {
                    return refuse(io, "plot.range-invalid", "a band has LO above HI", "--band LO,HI with LO at most HI");
                }
                ac[2] = ac[2] + 1;
            } else if bytes.equal(flag, "--with") {
                ac[4] = 0;
                if bytes.equal(value, "lines") {
                    lines = true;
                } else if bytes.equal(value, "points") {
                    lines = false;
                } else if bytes.equal(value, "bars") {
                    lines = false;
                    ac[4] = 1;
                } else if bytes.equal(value, "hist") {
                    lines = false;
                    ac[4] = 2;
                } else if bytes.equal(value, "box") {
                    lines = false;
                    ac[4] = 3;
                } else if bytes.equal(value, "heat") {
                    lines = false;
                    ac[4] = 4;
                } else if bytes.equal(value, "hbars") {
                    lines = false;
                    ac[4] = 5;
                } else {
                    return refuse(io, "plot.usage", "--with takes points, lines, bars, hbars, hist, box or heat", "--with bars");
                }
            } else if bytes.equal(flag, "--size") {
                let (a, b) = size_of(value);
                sw = a;
                sh = b;
                if a < 0 || b < 0 {
                    return refuse(io, "plot.size-invalid", "the size is WxH", "--size 60x20");
                }
            } else {
                return refuse(io, "plot.usage", "unknown flag", "the flags: --x --y --with --term --size --title --vline --hline --band --diag --categories --yerr --ylo --yhi --xhi --z --curve --logy --by --json");
            }
            k = k + 2;
        }
    }
    if !seen_x || !seen_y && curve_kind != 1 && curve_kind != 3 {
        return refuse(io, "plot.usage", "--x and --y are needed", "plot --x day --y net < table.csv");
    }
    // the size: characters for dumb, pixels for svg
    var w = 60;
    var hh = 20;
    if svg_term {
        w = 640;
        hh = 400;
    }
    if sw >= 0 {
        var ok = sw >= 10 && sw <= 200 && sh >= 5 && sh <= 60;
        if svg_term {
            ok = sw >= 100 && sw <= 2000 && sh >= 100 && sh <= 1200;
        }
        if !ok {
            if svg_term {
                return refuse(io, "plot.size-invalid", "for svg the size is WxH pixels, W from 100 to 2000 and H from 100 to 1200", "--size 640x400");
            }
            return refuse(io, "plot.size-invalid", "for dumb the size is WxH characters, W from 10 to 200 and H from 5 to 60", "--size 60x20");
        }
        w = sw;
        hh = sh;
    }
    let (text0, big) = read_all(heap, io);
    var text = text0;
    var status = 0;
    var json_code = 0;
    var json_row = 0;
    if use_json && !big {
        // the document as the table the rest reads (section 23)
        var fields = buffer.append(heap, buffer.empty(heap, 64), xspec);
        if len(yspec) > 0 {
            fields = buffer.push(heap, fields, byte_of(','));
            fields = buffer.append(heap, fields, yspec);
        }
        if len(yerr) > 0 {
            fields = buffer.push(heap, fields, byte_of(','));
            fields = buffer.append(heap, fields, yerr);
        }
        if len(yhi) > 0 {
            fields = buffer.push(heap, fields, byte_of(','));
            fields = buffer.append(heap, fields, yhi);
        }
        if len(xhi) > 0 {
            fields = buffer.push(heap, fields, byte_of(','));
            fields = buffer.append(heap, fields, xhi);
        }
        if use_by {
            fields = buffer.push(heap, fields, byte_of(','));
            fields = buffer.append(heap, fields, by_spec);
        }
        var table = buffer.empty(heap, 1);
        borrow text as &t0 in {
            borrow fields as &fb in {
                let (c, r0, cb) = jsontable.to_csv(heap, buffer.bytes(t0), json_path, buffer.bytes(fb));
                json_code = c;
                json_row = r0;
                buffer.drop(heap, table);
                table = cb;
            }
        }
        buffer.drop(heap, fields);
        buffer.drop(heap, text);
        text = table;
    }
    var curve_code = 0;
    var curve_line = 0;
    if use_by && !big && json_code == 0 {
        var table = buffer.empty(heap, 1);
        var groups = 0;
        borrow text as &t2 in {
            let (c, l, g, cb) = by.to_csv(heap, buffer.bytes(t2), xspec, yspec, by_spec);
            curve_code = c;
            curve_line = l;
            groups = g;
            buffer.drop(heap, table);
            table = cb;
        }
        buffer.drop(heap, text);
        text = table;
        xspec = "1";
        if groups == 1 {
            yspec = "2";
        } else if groups == 2 {
            yspec = "2,3";
        } else if groups == 3 {
            yspec = "2,3,4";
        } else if groups == 4 {
            yspec = "2,3,4,5";
        } else {
            yspec = "2,3,4,5,6";
        }
    }
    if curve_kind > 0 && !big && json_code == 0 {
        var table = buffer.empty(heap, 1);
        borrow text as &t1 in {
            let (c, l, cb) = curve.to_csv(heap, buffer.bytes(t1), curve_kind, xspec, yspec);
            curve_code = c;
            curve_line = l;
            buffer.drop(heap, table);
            table = cb;
        }
        buffer.drop(heap, text);
        text = table;
        xspec = "1";
        yspec = "2";
        lines = curve_kind != 3;
    }
    if json_code == 12 {
        status = refuse(io, "plot.json-invalid", "the input is not a JSON document", "pipe a document printed by stats or ml");
    } else if json_code == 13 {
        status = refuse(io, "plot.json-path", "the path leads nowhere, or not to rows: an array of objects, or an object with columns and rows", "--json data.importance.columns");
    } else if json_code == 14 {
        status = refuse_line(heap, io, "plot.json-field", "a row has no such field, or it is null", "name a field every row has (a dotted path for a nested one)", json_row);
    } else if json_code == 15 {
        status = refuse_line(heap, io, "plot.json-value", "a value is not a number or a plain string (no quote, comma or control byte)", "plot a numeric field, or a text one for a category", json_row);
    } else if json_code == 6 {
        status = refuse(io, "plot.too-many-points", "more than 5000 rows", "plot fewer rows");
    } else if curve_code == 2 {
        status = refuse_line(heap, io, "plot.not-numeric", "a cell of a curve column is not a number", "check the table, or choose other columns", curve_line);
    } else if curve_code == 3 {
        status = refuse_line(heap, io, "plot.csv-shape", "a line has a different number of cells than the header", "check the table", curve_line);
    } else if curve_code == 17 {
        status = refuse_line(heap, io, "plot.roc-label", "a label of the ROC is not 0 or 1", "--x names a column of 0 and 1", curve_line);
    } else if curve_code == 8 {
        status = refuse(io, "plot.too-many-series", "more than 5 groups", "plot at most 5 groups");
    } else if curve_code == 10 {
        status = refuse(io, "plot.text-invalid", "a group has a control byte in its text", "remove it");
    } else if curve_code == 20 {
        status = refuse_line(heap, io, "plot.by-misaligned", "a group does not give the x values of the first group in the same order", "give every group the same x values, one row each", curve_line);
    } else if curve_code == 18 {
        status = refuse(io, "plot.roc-classes", "the ROC needs both classes: a 0 and a 1 in the label column", "check the label column");
    } else if curve_code == 1 {
        status = refuse(io, "plot.csv-quote", "a double quote was found; quoted cells are not read", "write the table without quotes");
    } else if curve_code == 4 {
        status = refuse(io, "plot.empty", "the table has no rows", "give it at least one row after the header");
    } else if curve_code == 5 {
        status = refuse(io, "plot.column-missing", "a column is not in the header", "name it as the header does, or number it from 1");
    } else if curve_code == 6 {
        status = refuse(io, "plot.too-many-points", "more than 4999 rows for a curve", "plot fewer rows");
    } else if big {
        status = refuse(io, "plot.too-many-points", "the input is longer than 16 MiB", "plot fewer rows");
    } else {
        borrow text as &tb in {
            let (code, line, chart) = chart.draw(heap, buffer.bytes(tb), xspec, yspec, yerr, yhi, xhi, w, hh, title, has_title, lines, svg_term, ann, ac);
            if code == 0 {
                borrow chart as &cb in {
                    let wr = buffer.write(io, cb);
                }
            } else if code == 1 {
                status = refuse(io, "plot.csv-quote", "a double quote was found; quoted cells are not read", "write the table without quotes");
            } else if code == 2 {
                status = refuse_line(heap, io, "plot.not-numeric", "a cell of a plotted column is not a number", "check the table, or choose other columns", line);
            } else if code == 3 {
                status = refuse_line(heap, io, "plot.csv-shape", "a line has a different number of cells than the header", "check the table", line);
            } else if code == 4 {
                status = refuse(io, "plot.empty", "the table has no rows", "give it at least one row after the header");
            } else if code == 5 {
                status = refuse(io, "plot.column-missing", "a column is not in the header", "name it as the header does, or number it from 1");
            } else if code == 6 {
                status = refuse(io, "plot.too-many-points", "more than 5000 rows", "plot fewer rows");
            } else if code == 7 {
                status = refuse(io, "plot.range-invalid", "a range is beyond 1e15 of zero, narrower than 1e-12, or 1e12 times narrower than its distance from zero", "plot the difference from a base value");
            } else if code == 11 {
                status = refuse(io, "plot.usage", "--yerr, or --ylo with --yhi, needs one column for each series; --with hist needs --xhi and no intervals or categories, and --xhi only goes with hist; --with box needs five --y columns (lower, q1, median, q3, upper) and no intervals or categories; --with heat needs one --y column and --z, and no intervals or categories; --with hbars needs categories (one or more --y columns) and no intervals, markers or --diag; --logy only goes with points or lines, with no intervals and no --diag", "--yerr e1,e2 for --y a,b; --with hist --x lo --xhi hi --y count");
            } else if code == 19 {
                status = refuse_line(heap, io, "plot.log-nonpositive", "a value on a log axis (a y value, an --hline or a --band end) is not above 0", "drop or shift the value, or plot without --logy", line);
            } else if code == 21 {
                status = refuse_line(heap, io, "plot.negative-bar", "a bar value is below 0; horizontal bars start at 0", "plot values of 0 or more, or use --with bars", line);
            } else if code == 16 {
                status = refuse_line(heap, io, "plot.duplicate-cell", "a cell of the heatmap is given twice", "give each pair of labels once", line);
            } else if code == 8 {
                status = refuse(io, "plot.too-many-series", "more than 5 series", "plot at most 5 columns");
            } else if code == 9 {
                status = refuse(io, "plot.size-invalid", "the plot area would be under 20 pixels wide or high; the labels and margins take the rest", "a larger --size");
            } else {
                status = refuse(io, "plot.text-invalid", "the title or a series name has a control byte", "remove it");
            }
            buffer.drop(heap, chart);
        }
    }
    buffer.drop(heap, text);
    return status;
}

fn run[&h, &i, &g](heap: &!h Heap, io: &!i Io, args: &g Args) -> [heap, io_read, io_write, err_write, args] int {
    if arg_count(args) < 2 {
        return refuse(io, "plot.usage", "a verb or a flag is needed", "plot ticks 0 10 5, or plot --x COL --y COL < table.csv");
    }
    let verb = arg(args, 1);
    if bytes.equal(verb, "ticks") {
        return do_ticks(heap, io, args);
    }
    if len(verb) > 1 && int_of(verb[0]) == '-' {
        return do_chart(heap, io, args);
    }
    return refuse(io, "plot.usage", "unknown verb", "the verbs built so far: ticks");
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow mut io as &!i in {
                status = run(h, i, g);
            }
        }
    }
    release(heap);
    release(fs);
    release(args);
    release(io);
    return status;
}
