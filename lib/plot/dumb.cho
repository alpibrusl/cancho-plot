edition 9;

module plot.dumb;

import plot.axis;
import plot.ticks;
import std.buffer;

// The text terminal (docs/design.md sections 11 and 13): the points of a table in, a chart of characters out.

fn clamp(c: int, size: int) -> [] int {
    if c < 0 {
        return 0;
    }
    if c > size - 1 {
        return size - 1;
    }
    return c;
}

// floor((v - lo) * size / (hi - lo)), clamped to the last cell, with 1e-9 of a cell of slack
fn colcell(v: float, lo: float, hi: float, size: int) -> [] int {
    return clamp(truncate((v - lo) * float_of(size) / (hi - lo) + 1.0e-9), size);
}

// floor((hi - v) * size / (hi - lo)), clamped: row 0 is the top
fn rowcell(v: float, lo: float, hi: float, size: int) -> [] int {
    return clamp(truncate((hi - v) * float_of(size) / (hi - lo) + 1.0e-9), size);
}

fn spaces[&h](heap: &!h Heap, b: buffer.Buffer, n: int) -> [heap] buffer.Buffer {
    var out = b;
    var i = 0;
    while i < n {
        out = buffer.push(heap, out, byte_of(' '));
        i = i + 1;
    }
    return out;
}

// the line, without its trailing spaces, and a newline, appended to `out`
fn flush[&h](heap: &!h Heap, out: buffer.Buffer, line: buffer.Buffer) -> [heap] buffer.Buffer {
    var o = out;
    borrow line as &lb in {
        let bs = buffer.bytes(lb);
        var n = len(bs);
        while n > 0 && int_of(bs[n - 1]) == ' ' {
            n = n - 1;
        }
        o = buffer.append(heap, o, bs[0..n]);
    }
    buffer.drop(heap, line);
    return buffer.push(heap, o, byte_of(10));
}

// The chart of the `n` points of `xs` and the `k` series of `ys` (series j is ys[j*n..j*n+n]), `w` by `h` characters; the names of the series are text[ns[j]..ne[j]].
pub fn render[&h, &t, &a, &b, &c, &d, &z, &e, &f](heap: &!h Heap, text: &t [byte], xs: &a [float], ys: &b [float], n: int, k: int, ns: &c [int], ne: &d [int], w: int, hh: int, title: &z [byte], has_title: bool, lines: bool, ann: &e [float], ac: &f [int]) -> [heap] buffer.Buffer {
    let (xlo, xhi, ylo, yhi) = axis.extent(xs, ys, n, k, ann, ac);
    var i = 0;
    let (xl0, xh0, xok) = axis.fix(xlo, xhi);
    let (yl0, yh0, yok) = axis.fix(ylo, yhi);
    let (xlo2, xhi2, xm, xe, xk0, xk1) = axis.axis(xl0, xh0, 6);
    let (ylo2, yhi2, ym, ye, yk0, yk1) = axis.axis(yl0, yh0, 5);
    var out = buffer.empty(heap, 4096);
    region r {
        let grid = alloc_slice[r](w * hh, byte_of(' '));
        let glyphs = "*+xo#";
        // the annotations, under the series (section 15): bands, then horizontal lines, then vertical ones, then the diagonal
        var u = 0;
        while u < ac[2] {
            var rr = rowcell(ann[17 + 2 * u], ylo2, yhi2, hh);
            let last = rowcell(ann[16 + 2 * u], ylo2, yhi2, hh);
            while rr <= last {
                var cc = 0;
                while cc < w {
                    grid[rr * w + cc] = byte_of(':');
                    cc = cc + 1;
                }
                rr = rr + 1;
            }
            u = u + 1;
        }
        u = 0;
        while u < ac[1] {
            let rr = rowcell(ann[8 + u], ylo2, yhi2, hh);
            var cc = 0;
            while cc < w {
                grid[rr * w + cc] = byte_of('-');
                cc = cc + 1;
            }
            u = u + 1;
        }
        u = 0;
        while u < ac[0] {
            let cc = colcell(ann[u], xlo2, xhi2, w);
            var rr = 0;
            while rr < hh {
                grid[rr * w + cc] = byte_of('|');
                rr = rr + 1;
            }
            u = u + 1;
        }
        var t0 = xlo2;
        if ylo2 > t0 {
            t0 = ylo2;
        }
        var t1 = xhi2;
        if yhi2 < t1 {
            t1 = yhi2;
        }
        if ac[3] == 1 && t0 < t1 {
            let c0 = colcell(t0, xlo2, xhi2, w);
            let r0 = rowcell(t0, ylo2, yhi2, hh);
            let c1 = colcell(t1, xlo2, xhi2, w);
            let r1 = rowcell(t1, ylo2, yhi2, hh);
            // t0 < t1, so the diagonal goes right and up: the column grows and the row falls
            let dc = c1 - c0;
            let dr = r0 - r1;
            var m = dc;
            if dr > m {
                m = dr;
            }
            var step = 0;
            while step <= m {
                var cc = c0;
                var rr = r0;
                if m > 0 {
                    cc = c0 + (2 * dc * step + m) / (2 * m);
                    rr = r0 - (2 * dr * step + m) / (2 * m);
                }
                grid[rr * w + cc] = byte_of('/');
                step = step + 1;
            }
        }
        var j = 0;
        while j < k {
            i = 0;
            while i < n {
                let col = colcell(xs[i], xlo2, xhi2, w);
                let row = rowcell(ys[j * n + i], ylo2, yhi2, hh);
                if lines && i > 0 {
                    // the segment from the previous point (section 13): integers only, a half goes up
                    let c0 = colcell(xs[i - 1], xlo2, xhi2, w);
                    let r0 = rowcell(ys[j * n + i - 1], ylo2, yhi2, hh);
                    var dc = col - c0;
                    var dr = row - r0;
                    var sc = 1;
                    var sr = 1;
                    if dc < 0 {
                        dc = 0 - dc;
                        sc = 0 - 1;
                    }
                    if dr < 0 {
                        dr = 0 - dr;
                        sr = 0 - 1;
                    }
                    var m = dc;
                    if dr > m {
                        m = dr;
                    }
                    var step = 0;
                    while step <= m && m > 0 {
                        let cc = c0 + sc * ((2 * dc * step + m) / (2 * m));
                        let rr = r0 + sr * ((2 * dr * step + m) / (2 * m));
                        grid[rr * w + cc] = glyphs[j];
                        step = step + 1;
                    }
                }
                grid[row * w + col] = glyphs[j];
                i = i + 1;
            }
            j = j + 1;
        }
        // the labels of the y axis
        let nt = yk1 - yk0 + 1;
        let yoff = alloc_slice[r](nt + 1, 0);
        let yrow = alloc_slice[r](nt, 0);
        var yl = buffer.empty(heap, 128);
        var g = 0;
        var t = 0;
        while t < nt {
            let (yl1, before) = axis.used(yl);
            yoff[t] = before;
            let yl2 = ticks.label(heap, yl1, yk0 + t, ym, ye);
            let (yl3, after) = axis.used(yl2);
            yl = yl3;
            yrow[t] = rowcell(ticks.value(yk0 + t, ym, ye), ylo2, yhi2, hh);
            t = t + 1;
        }
        let (yl4, total) = axis.used(yl);
        yl = yl4;
        yoff[nt] = total;
        // the gutter is as wide as the longest label that is drawn: when two ticks fall in one row the higher one is drawn
        t = 0;
        while t < nt {
            var shown = true;
            var t2 = t + 1;
            while t2 < nt {
                if yrow[t2] == yrow[t] {
                    shown = false;
                }
                t2 = t2 + 1;
            }
            if shown && yoff[t + 1] - yoff[t] > g {
                g = yoff[t + 1] - yoff[t];
            }
            t = t + 1;
        }
        borrow yl as &ylb in {
            let lab = buffer.bytes(ylb);
            if has_title {
                var line = spaces(heap, buffer.empty(heap, 64), g + 2);
                var pad = (w - len(title)) / 2;
                if pad < 0 {
                    pad = 0;
                }
                line = spaces(heap, line, pad);
                line = buffer.append(heap, line, title);
                out = flush(heap, out, line);
            }
            var row = 0;
            while row < hh {
                var line = buffer.empty(heap, 64);
                var which = 0 - 1;
                t = 0;
                while t < nt {
                    if yrow[t] == row {
                        which = t;
                    }
                    t = t + 1;
                }
                var lw = 0;
                if which >= 0 {
                    lw = yoff[which + 1] - yoff[which];
                }
                line = spaces(heap, line, g - lw);
                if which >= 0 {
                    line = buffer.append(heap, line, lab[yoff[which]..yoff[which + 1]]);
                }
                line = buffer.push(heap, line, byte_of(' '));
                line = buffer.push(heap, line, byte_of('|'));
                line = buffer.append(heap, line, grid[row * w..row * w + w]);
                out = flush(heap, out, line);
                row = row + 1;
            }
        }
        buffer.drop(heap, yl);
        // the x axis
        var line = spaces(heap, buffer.empty(heap, 64), g);
        line = buffer.push(heap, line, byte_of(' '));
        line = buffer.push(heap, line, byte_of('+'));
        var d = 0;
        while d < w {
            line = buffer.push(heap, line, byte_of('-'));
            d = d + 1;
        }
        out = flush(heap, out, line);
        // the labels of the x axis
        let xl = alloc_slice[r](w, byte_of(' '));
        var prev_end = 0 - 2;
        var q = xk0;
        while q <= xk1 {
            let (lb, ln) = axis.used(ticks.label(heap, buffer.empty(heap, 16), q, xm, xe));
            let col = colcell(ticks.value(q, xm, xe), xlo2, xhi2, w);
            var start = col - ln / 2;
            if start > w - ln {
                start = w - ln;
            }
            if start < 0 {
                start = 0;
            }
            if ln <= w && start >= prev_end + 1 {
                borrow lb as &lbb in {
                    let bs = buffer.bytes(lbb);
                    var u = 0;
                    while u < ln {
                        xl[start + u] = bs[u];
                        u = u + 1;
                    }
                }
                prev_end = start + ln;
            }
            buffer.drop(heap, lb);
            q = q + 1;
        }
        line = spaces(heap, buffer.empty(heap, 64), g + 2);
        line = buffer.append(heap, line, xl[0..w]);
        out = flush(heap, out, line);
        // the legend
        line = buffer.empty(heap, 64);
        j = 0;
        while j < k {
            if j > 0 {
                line = buffer.append(heap, line, "  ");
            }
            line = buffer.push(heap, line, glyphs[j]);
            line = buffer.push(heap, line, byte_of(' '));
            line = buffer.append(heap, line, text[ns[j]..ne[j]]);
            j = j + 1;
        }
        out = flush(heap, out, line);
    }
    return out;
}
