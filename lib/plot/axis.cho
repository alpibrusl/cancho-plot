edition 9;

module plot.axis;

import plot.ticks;
import std.buffer;

// What the two terminals share (docs/design.md sections 10, 11 and 13): the axis of a range, and the size of a buffer.

// the number of bytes in a buffer
pub fn used[&h](b: buffer.Buffer) -> [] (buffer.Buffer, int) {
    var n = 0;
    borrow b as &q in {
        n = buffer.size(q);
    }
    return (b, n);
}

// the range of the values widened by 1 each way when it is a point, and whether the ticks can stand for it (section 10): (lo, hi, ok)
pub fn fix(lo0: float, hi0: float) -> [] (float, float, bool) {
    var lo = lo0;
    var hi = hi0;
    if lo == hi {
        lo = lo - 1.0;
        hi = hi + 1.0;
    }
    var far = hi;
    if 0.0 - lo > far {
        far = 0.0 - lo;
    }
    let span = hi - lo;
    if far > 1.0e15 || span < 1.0e-12 || far / span > 1.0e12 {
        return (lo, hi, false);
    }
    return (lo, hi, true);
}

// the widened range and its ticks: (lo, hi, m, e, first, last)
pub fn axis(lo: float, hi: float, n: int, lg: bool) -> [] (float, float, int, int, int, int) {
    let (m0, e0) = ticks.step(hi - lo, n);
    // a log axis has its ticks at whole exponents (section 33)
    var m = m0;
    var e = e0;
    if lg && e0 < 0 {
        m = 1;
        e = 0;
    }
    let (k0, k1) = ticks.enclose(lo, hi, m, e);
    return (ticks.value(k0, m, e), ticks.value(k1, m, e), m, e, k0, k1);
}

// The ranges of a chart: the points, and the annotations (docs/design.md section 15). `ann` holds the --vline values at 0, the --hline values at 8 and the band ends (lo, hi) at 16; `ac` holds how many of
// each there are (vlines, hlines, bands) and whether the diagonal is asked for; `ac[4]` is 1 for bars and `ac[5]` is how many series have error bars. Answers (xlo, xhi, ylo, yhi).
pub fn extent[&a, &b, &c, &d](xs: &a [float], ys: &b [float], n: int, k: int, ann: &c [float], ac: &d [int]) -> [] (float, float, float, float) {
    var xlo = xs[0];
    var xhi = xs[0];
    var ylo = ys[0];
    var yhi = ys[0];
    var i = 0;
    while i < n {
        if xs[i] < xlo {
            xlo = xs[i];
        }
        if xs[i] > xhi {
            xhi = xs[i];
        }
        i = i + 1;
    }
    i = 0;
    while i < k * n {
        if ys[i] < ylo {
            ylo = ys[i];
        }
        if ys[i] > yhi {
            yhi = ys[i];
        }
        i = i + 1;
    }
    i = 0;
    while i < ac[0] {
        if ann[i] < xlo {
            xlo = ann[i];
        }
        if ann[i] > xhi {
            xhi = ann[i];
        }
        i = i + 1;
    }
    i = 0;
    while i < ac[1] {
        if ann[8 + i] < ylo {
            ylo = ann[8 + i];
        }
        if ann[8 + i] > yhi {
            yhi = ann[8 + i];
        }
        i = i + 1;
    }
    i = 0;
    while i < 2 * ac[2] {
        if ann[16 + i] < ylo {
            ylo = ann[16 + i];
        }
        if ann[16 + i] > yhi {
            yhi = ann[16 + i];
        }
        i = i + 1;
    }
    // bars and histogram bars start at 0 (sections 20 and 25)
    if ac[4] == 1 || ac[4] == 2 {
        if ylo > 0.0 {
            ylo = 0.0;
        }
        if yhi < 0.0 {
            yhi = 0.0;
        }
    }
    // a histogram's x range runs to the highest upper edge, which follows the error columns in ys
    if ac[4] == 2 {
        i = 0;
        while i < n {
            let hi = ys[(k + 2 * ac[5]) * n + i];
            if hi > xhi {
                xhi = hi;
            }
            i = i + 1;
        }
    }
    // error bars: value - down and value + up (after the k series, ys holds the ke columns of `down` and then the ke of `up`)
    var j = 0;
    while j < ac[5] {
        i = 0;
        while i < n {
            let v = ys[j * n + i];
            let down = ys[(k + j) * n + i];
            let up = ys[(k + ac[5] + j) * n + i];
            if v - down < ylo {
                ylo = v - down;
            }
            if v + up > yhi {
                yhi = v + up;
            }
            i = i + 1;
        }
        j = j + 1;
    }
    // a log axis runs between whole exponents, one decade at least (section 33)
    if ac[8] == 1 {
        var a = truncate(ylo);
        if float_of(a) > ylo {
            a = a - 1;
        }
        var b = truncate(yhi);
        if float_of(b) < yhi {
            b = b + 1;
        }
        if b == a {
            b = a + 1;
        }
        ylo = float_of(a);
        yhi = float_of(b);
    }
    return (xlo, xhi, ylo, yhi);
}

// the label of a y tick: the number, or the power of ten it stands for on a log axis
pub fn label_y[&h, &c](heap: &!h Heap, out: buffer.Buffer, k: int, m: int, e: int, ac: &c [int]) -> [heap] buffer.Buffer {
    if ac[8] == 1 {
        return ticks.label_log(heap, out, k, m, e);
    }
    return ticks.label(heap, out, k, m, e);
}
