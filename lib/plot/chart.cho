edition 9;

module plot.chart;

import plot.axis;
import plot.csv;
import plot.dumb;
import plot.heat;
import plot.num;
import plot.svg;
import std.buffer;
import std.math;

// A table in memory in, a chart out (docs/design.md sections 11 and 13). The codes `draw` answers with: 0 done; 1 a double quote; 2 a cell that is not a number; 3 a line with the wrong number of cells;
// 4 no rows; 5 a column that is not there; 6 more than 5,000 rows; 7 a range the ticks cannot stand for; 8 more than 5 series; 9 a plot area under 20 (svg); 10 a control byte in the title or a name.
// The caller maps them to rule tags.

// do the two spans of the text read the same
fn same_span[&t](text: &t [byte], a: int, b: int, c: int, d: int) -> [] bool {
    if b - a != d - c {
        return false;
    }
    var i = 0;
    while i < b - a {
        if text[a + i] != text[c + i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// does the text hold a byte below 0x20 or the byte 0x7f
fn has_control[&t](text: &t [byte]) -> [] bool {
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 32 || c == 127 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Read the table in `text` and draw it: x from the column `xspec`, the series from the columns of the comma-separated `yspec`. Answers (code, line, chart): `line` is the line of the table the code is about (from 1).
pub fn draw[&h, &t, &x, &y, &q, &q2, &q3, &z, &e, &f](heap: &!h Heap, text: &t [byte], xspec: &x [byte], yspec: &y [byte], yerr: &q [byte], yhi: &q2 [byte], xhi: &q3 [byte], w: int, hh: int, title: &z [byte], has_title: bool, lines: bool, svg_term: bool, ann: &!e [float], ac: &!f [int]) -> [heap] (int, int, buffer.Buffer) {
    let none = buffer.empty(heap, 1);
    if len(text) == 0 {
        return (4, 0, none);
    }
    if csv.has_quote(text) {
        return (1, 0, none);
    }
    if has_title && has_control(title) {
        return (10, 0, none);
    }
    let hend = csv.line_end(text, 0);
    // the series asked for
    var ycount = 1;
    var s = 0;
    while s < len(yspec) {
        if int_of(yspec[s]) == ',' {
            ycount = ycount + 1;
        }
        s = s + 1;
    }
    if ycount > 5 {
        return (8, 0, none);
    }
    // the half-lengths of the error bars: one column for each series, or none (section 20)
    var ke = 0;
    if len(yerr) > 0 {
        ke = 1;
        var t3 = 0;
        while t3 < len(yerr) {
            if int_of(yerr[t3]) == ',' {
                ke = ke + 1;
            }
            t3 = t3 + 1;
        }
        if ke != ycount {
            return (11, 0, none);
        }
    }
    // the upper ends: --ylo and --yhi go together (ac[6] is 1 for them), one column for each series
    var kh = 0;
    if len(yhi) > 0 {
        kh = 1;
        var t4 = 0;
        while t4 < len(yhi) {
            if int_of(yhi[t4]) == ',' {
                kh = kh + 1;
            }
            t4 = t4 + 1;
        }
    }
    if ac[6] == 1 && kh != ke {
        return (11, 0, none);
    }
    if ac[6] != 1 && kh > 0 {
        return (11, 0, none);
    }
    // a histogram (section 25) takes the column of the upper edges and nothing else of the intervals or the categories
    if ac[4] == 2 && (len(xhi) == 0 || ke > 0 || ac[7] == 1) {
        return (11, 0, none);
    }
    // a heatmap (section 29) takes one column for its rows, the value column in `xhi`, and no intervals or categories
    if ac[4] == 4 && (ycount != 1 || len(xhi) == 0 || ke > 0 || ac[7] == 1) {
        return (11, 0, none);
    }
    if ac[4] != 2 && ac[4] != 4 && len(xhi) > 0 {
        return (11, 0, none);
    }
    // a box plot (section 27) takes five columns, in the order lower, q1, median, q3, upper, and no intervals or categories (--ylo and --yhi count as intervals: kh is ke when they are given)
    if ac[4] == 3 && (ycount != 5 || ke > 0 || ac[7] == 1) {
        return (11, 0, none);
    }
    // a log axis (section 33) is for points and lines, with no intervals and no diagonal
    if ac[8] == 1 && (ac[4] != 0 || ke > 0 || ac[3] == 1) {
        return (11, 0, none);
    }
    ac[5] = ke;
    var xcol = csv.column(text, 0, hend, xspec);
    var ycols = 0 - 1;
    var code = 0;
    var line = 0;
    var out = none;
    region r {
        let yc = alloc_slice[r](5, 0);
        let ec = alloc_slice[r](5, 0);
        let eh = alloc_slice[r](5, 0);
        var hcol = 0 - 1;
        if ac[4] == 2 || ac[4] == 4 {
            hcol = csv.column(text, 0, hend, xhi);
            if hcol < 0 {
                code = 5;
            }
        }
        let ns = alloc_slice[r](5, 0);
        let ne = alloc_slice[r](5, 0);
        var from = 0;
        var j = 0;
        var p = 0;
        while p <= len(yspec) && code == 0 {
            if p == len(yspec) || int_of(yspec[p]) == ',' {
                let c = csv.column(text, 0, hend, yspec[from..p]);
                if c < 0 {
                    code = 5;
                } else {
                    yc[j] = c;
                    let (a, b) = csv.cell(text, 0, hend, c);
                    ns[j] = a;
                    ne[j] = b;
                    if has_control(text[a..b]) {
                        code = 10;
                    }
                    j = j + 1;
                }
                from = p + 1;
            }
            p = p + 1;
        }
        var ef = 0;
        var ej = 0;
        var ep = 0;
        while ep <= len(yerr) && code == 0 && ke > 0 {
            if ep == len(yerr) || int_of(yerr[ep]) == ',' {
                let c = csv.column(text, 0, hend, yerr[ef..ep]);
                if c < 0 {
                    code = 5;
                } else {
                    ec[ej] = c;
                    ej = ej + 1;
                }
                ef = ep + 1;
            }
            ep = ep + 1;
        }
        var hf = 0;
        var hj = 0;
        var hp = 0;
        while hp <= len(yhi) && code == 0 && kh > 0 {
            if hp == len(yhi) || int_of(yhi[hp]) == ',' {
                let c = csv.column(text, 0, hend, yhi[hf..hp]);
                if c < 0 {
                    code = 5;
                } else {
                    eh[hj] = c;
                    hj = hj + 1;
                }
                hf = hp + 1;
            }
            hp = hp + 1;
        }
        if xcol < 0 {
            code = 5;
        }
        // the rows
        var n = 0;
        var at = csv.next_line(text, hend);
        while at < len(text) {
            n = n + 1;
            at = csv.next_line(text, csv.line_end(text, at));
        }
        if code == 0 && n == 0 {
            code = 4;
        }
        if code == 0 && n > 5000 {
            code = 6;
        }
        if code == 0 {
            let ncols = csv.cells(text, 0, hend);
            let xsb = box_slice(heap, n, 0.0);
            var extra = 0;
            if ac[4] == 2 || ac[4] == 4 {
                extra = 1;
            }
            let ysb = box_slice(heap, n * (ycount + 2 * ke + extra), 0.0);
            let clb = box_slice(heap, 6 * n, 0);
            borrow mut xsb as &!xw in {
                borrow mut ysb as &!yw in {
                    borrow mut clb as &!cw in {
                        let xs = contents(xw);
                        let ys = contents(yw);
                        let cl = contents(cw);
                        var row = 0;
                        at = csv.next_line(text, hend);
                        while row < n && code == 0 {
                            let end = csv.line_end(text, at);
                            if csv.cells(text, at, end) != ncols {
                                code = 3;
                                line = row + 2;
                            } else {
                                let (a, b) = csv.cell(text, at, end, xcol);
                                if ac[4] == 1 || ac[4] == 3 || ac[4] == 4 || ac[7] == 1 {
                                    // a category: its label is the cell, its place the row (section 20)
                                    xs[row] = float_of(row);
                                    cl[2 * row] = a;
                                    cl[2 * row + 1] = b;
                                    if has_control(text[a..b]) {
                                        code = 10;
                                    }
                                } else {
                                    let (ok, v) = num.number(text[a..b]);
                                    if !ok {
                                        code = 2;
                                        line = row + 2;
                                    } else {
                                        xs[row] = v;
                                    }
                                }
                                if (ac[4] == 2 || ac[4] == 4) && code == 0 {
                                    // the upper edge, or the value of a cell of the bin, after the columns of the series and of the errors
                                    let (c3, d3) = csv.cell(text, at, end, hcol);
                                    let (ok5, v5) = num.number(text[c3..d3]);
                                    if !ok5 {
                                        code = 2;
                                        line = row + 2;
                                    } else if ac[4] == 2 && v5 <= xs[row] {
                                        code = 7;
                                        line = row + 2;
                                    } else {
                                        ys[(ycount + 2 * ke) * n + row] = v5;
                                        cl[4 * n + 2 * row] = c3;
                                        cl[4 * n + 2 * row + 1] = d3;
                                    }
                                }
                                var q = 0;
                                if ac[4] == 4 {
                                    // the row of a heatmap cell is a label too
                                    let (c, d) = csv.cell(text, at, end, yc[0]);
                                    cl[2 * n + 2 * row] = c;
                                    cl[2 * n + 2 * row + 1] = d;
                                    if has_control(text[c..d]) {
                                        code = 10;
                                    }
                                    q = ycount;
                                }
                                while q < ycount && code == 0 {
                                    let (c, d) = csv.cell(text, at, end, yc[q]);
                                    let (ok2, v2) = num.number(text[c..d]);
                                    if !ok2 {
                                        code = 2;
                                        line = row + 2;
                                    } else {
                                        ys[q * n + row] = v2;
                                    }
                                    q = q + 1;
                                }
                                if ac[4] == 3 && code == 0 {
                                    // the five numbers of a box are in order (section 27)
                                    if ys[row] > ys[n + row] || ys[n + row] > ys[2 * n + row] || ys[2 * n + row] > ys[3 * n + row] || ys[3 * n + row] > ys[4 * n + row] {
                                        code = 7;
                                        line = row + 2;
                                    }
                                }
                                var eq = 0;
                                while eq < ke && code == 0 {
                                    let (c, d) = csv.cell(text, at, end, ec[eq]);
                                    let (ok3, v3) = num.number(text[c..d]);
                                    if !ok3 {
                                        code = 2;
                                        line = row + 2;
                                    } else if ac[6] == 1 {
                                        // an interval given by its ends: how far it goes below and above the value
                                        let (c2, d2) = csv.cell(text, at, end, eh[eq]);
                                        let (ok4, v4) = num.number(text[c2..d2]);
                                        if !ok4 {
                                            code = 2;
                                            line = row + 2;
                                        } else if ys[eq * n + row] - v3 < 0.0 || v4 - ys[eq * n + row] < 0.0 {
                                            code = 7;
                                            line = row + 2;
                                        } else {
                                            ys[(ycount + eq) * n + row] = ys[eq * n + row] - v3;
                                            ys[(ycount + ke + eq) * n + row] = v4 - ys[eq * n + row];
                                        }
                                    } else if v3 < 0.0 {
                                        code = 7;
                                        line = row + 2;
                                    } else {
                                        ys[(ycount + eq) * n + row] = v3;
                                        ys[(ycount + ke + eq) * n + row] = v3;
                                    }
                                    eq = eq + 1;
                                }
                            }
                            at = csv.next_line(text, end);
                            row = row + 1;
                        }
                        if code == 0 && ac[8] == 1 {
                            // the values and the markers by their log10; one that is not above 0 has none (section 33)
                            var q = 0;
                            while q < ycount * n && code == 0 {
                                if ys[q] > 0.0 {
                                    ys[q] = math.log10(ys[q]);
                                } else {
                                    code = 19;
                                    line = q % n + 2;
                                }
                                q = q + 1;
                            }
                            q = 0;
                            while q < ac[1] && code == 0 {
                                if ann[8 + q] > 0.0 {
                                    ann[8 + q] = math.log10(ann[8 + q]);
                                } else {
                                    code = 19;
                                }
                                q = q + 1;
                            }
                            q = 0;
                            while q < 2 * ac[2] && code == 0 {
                                if ann[16 + q] > 0.0 {
                                    ann[16 + q] = math.log10(ann[16 + q]);
                                } else {
                                    code = 19;
                                }
                                q = q + 1;
                            }
                        }
                        if code == 0 && ac[4] == 4 {
                            // the categories of a heatmap, numbered by first appearance, and the cells given twice (section 29)
                            var cx = 0;
                            var cy = 0;
                            var r1 = 0;
                            while r1 < n {
                                var fx = 0 - 1;
                                var fy = 0 - 1;
                                var r2 = 0;
                                while r2 < r1 {
                                    if fx < 0 && same_span(text, cl[2 * r1], cl[2 * r1 + 1], cl[2 * r2], cl[2 * r2 + 1]) {
                                        fx = truncate(xs[r2]);
                                    }
                                    if fy < 0 && same_span(text, cl[2 * n + 2 * r1], cl[2 * n + 2 * r1 + 1], cl[2 * n + 2 * r2], cl[2 * n + 2 * r2 + 1]) {
                                        fy = truncate(ys[r2]);
                                    }
                                    r2 = r2 + 1;
                                }
                                if fx < 0 {
                                    fx = cx;
                                    cx = cx + 1;
                                }
                                if fy < 0 {
                                    fy = cy;
                                    cy = cy + 1;
                                }
                                xs[r1] = float_of(fx);
                                ys[r1] = float_of(fy);
                                r1 = r1 + 1;
                            }
                            if cx > 50 || cy > 50 {
                                code = 6;
                            }
                            r1 = 1;
                            while r1 < n && code == 0 {
                                var r2 = 0;
                                while r2 < r1 && code == 0 {
                                    if xs[r1] == xs[r2] && ys[r1] == ys[r2] {
                                        code = 16;
                                        line = r1 + 2;
                                    }
                                    r2 = r2 + 1;
                                }
                                r1 = r1 + 1;
                            }
                            if code == 0 {
                                buffer.drop(heap, out);
                                if svg_term {
                                    let (rc, chart) = heat.svg_render(heap, text, xs, ys, n, cl, w, hh, title, has_title);
                                    code = rc;
                                    out = chart;
                                } else {
                                    let (rc, chart) = heat.dumb_render(heap, text, xs, ys, n, cl, w, hh, title, has_title);
                                    code = rc;
                                    out = chart;
                                }
                            }
                        } else if code == 0 {
                            let (xlo, xhi, ylo, yhi) = axis.extent(xs, ys, n, ycount, ann, ac);
                            let (a, b, xok) = axis.fix(xlo, xhi);
                            let (c, d, yok) = axis.fix(ylo, yhi);
                            if !xok || !yok {
                                code = 7;
                            } else if ac[4] == 3 && !svg_term && w / n < 1 {
                                code = 9;
                            } else if ac[4] == 1 && !svg_term && w / n < ycount {
                                code = 9;
                            } else {
                                buffer.drop(heap, out);
                                if svg_term {
                                    let (rc, chart) = svg.render(heap, text, xs, ys, n, ycount, ns, ne, cl, w, hh, title, has_title, lines, ann, ac);
                                    code = rc;
                                    out = chart;
                                } else {
                                    out = dumb.render(heap, text, xs, ys, n, ycount, ns, ne, cl, w, hh, title, has_title, lines, ann, ac);
                                }
                            }
                        }
                    }
                }
            }
            unbox_slice(heap, clb);
            unbox_slice(heap, ysb);
            unbox_slice(heap, xsb);
        }
    }
    return (code, line, out);
}
