edition 9;

module plot.by;

import plot.csv;
import plot.curve;
import plot.num;
import std.buffer;

// One series for each value of a column (docs/design.md section 33): the long table (x, y, group) is written as the wide table (x, one column for each group) that the chart reads. The groups are in the order of first appearance, at most 5, and each gives the
// x values of the first, in the same order. The codes: 0 done; 1 a quote; 2 not a number (the line); 3 a line of the wrong width (the line); 4 no rows; 5 a column missing; 6 more than 4999 rows; 8 more than 5 groups;
// 10 a control byte in a group's text; 20 the groups do not line up (the line of the first row that does not, or 0 when a group has fewer rows). Answers (code, line, groups, table).

fn same_text[&t](text: &t [byte], a: int, b: int, c: int, d: int) -> [] bool {
    if b - a != d - c {
        return false;
    }
    var i = 0;
    while i < b - a {
        if text[a + i] != text[c + i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn to_csv[&h, &t, &x, &y, &g](heap: &!h Heap, text: &t [byte], xspec: &x [byte], yspec: &y [byte], byspec: &g [byte]) -> [heap] (int, int, int, buffer.Buffer) {
    var out = buffer.empty(heap, 256);
    if len(text) == 0 {
        return (4, 0, 0, out);
    }
    if csv.has_quote(text) {
        return (1, 0, 0, out);
    }
    let hend = csv.line_end(text, 0);
    let width = csv.cells(text, 0, hend);
    let xcol = csv.column(text, 0, hend, xspec);
    let ycol = csv.column(text, 0, hend, yspec);
    let gcol = csv.column(text, 0, hend, byspec);
    if xcol < 0 || ycol < 0 || gcol < 0 {
        return (5, 0, 0, out);
    }
    var n = 0;
    var at = csv.next_line(text, hend);
    while at < len(text) {
        n = n + 1;
        at = csv.next_line(text, csv.line_end(text, at));
    }
    if n == 0 {
        return (4, 0, 0, out);
    }
    if n > 4999 {
        return (6, 0, 0, out);
    }
    var code = 0;
    var line = 0;
    var groups = 0;
    let xb = box_slice(heap, n, 0.0);
    let yb = box_slice(heap, n, 0.0);
    let gb = box_slice(heap, n, 0);
    let x0b = box_slice(heap, n, 0.0);
    let cb = box_slice(heap, 5 * n, 0.0);
    borrow mut xb as &!xw in {
        borrow mut yb as &!yw in {
            borrow mut gb as &!gw in {
                borrow mut x0b as &!x0w in {
                    borrow mut cb as &!cw in {
                        let xs = contents(xw);
                        let ys = contents(yw);
                        let gi = contents(gw);
                        let x0 = contents(x0w);
                        let cells = contents(cw);
                        region r {
                            // the text of each group, as the start and the end of a cell, and how many rows each has so far
                            let gs = alloc_slice[r](10, 0);
                            let seen = alloc_slice[r](5, 0);
                            var row = 0;
                            var pos = csv.next_line(text, hend);
                            while row < n && code == 0 {
                                let end = csv.line_end(text, pos);
                                line = row + 2;
                                if csv.cells(text, pos, end) != width {
                                    code = 3;
                                } else {
                                    let (a, b) = csv.cell(text, pos, end, xcol);
                                    let (c, d) = csv.cell(text, pos, end, ycol);
                                    let (e, f) = csv.cell(text, pos, end, gcol);
                                    let (xok, xv) = num.number(text[a..b]);
                                    let (yok, yv) = num.number(text[c..d]);
                                    if !xok || !yok {
                                        code = 2;
                                    } else if curve.has_control(text[e..f]) {
                                        code = 10;
                                    } else {
                                        xs[row] = xv;
                                        ys[row] = yv;
                                        var found = 0 - 1;
                                        var j = 0;
                                        while j < groups {
                                            if found < 0 && same_text(text, gs[2 * j], gs[2 * j + 1], e, f) {
                                                found = j;
                                            }
                                            j = j + 1;
                                        }
                                        if found < 0 {
                                            if groups == 5 {
                                                code = 8;
                                            } else {
                                                gs[2 * groups] = e;
                                                gs[2 * groups + 1] = f;
                                                found = groups;
                                                groups = groups + 1;
                                            }
                                        }
                                        gi[row] = found;
                                    }
                                }
                                pos = csv.next_line(text, end);
                                row = row + 1;
                            }
                            if code == 0 {
                                // the x values of the first group set the rows; the others must match them position by position
                                var m = 0;
                                var q = 0;
                                while q < n {
                                    if gi[q] == 0 {
                                        x0[m] = xs[q];
                                        m = m + 1;
                                    }
                                    q = q + 1;
                                }
                                q = 0;
                                while q < n && code == 0 {
                                    let g0 = gi[q];
                                    let p = seen[g0];
                                    if p >= m || xs[q] != x0[p] {
                                        code = 20;
                                        line = q + 2;
                                    } else {
                                        cells[g0 * m + p] = ys[q];
                                        seen[g0] = p + 1;
                                    }
                                    q = q + 1;
                                }
                                var g1 = 1;
                                while g1 < groups && code == 0 {
                                    if seen[g1] != m {
                                        code = 20;
                                        line = 0;
                                    }
                                    g1 = g1 + 1;
                                }
                                if code == 0 {
                                    let (xa, xe) = csv.cell(text, 0, hend, xcol);
                                    out = buffer.append(heap, out, text[xa..xe]);
                                    var gj = 0;
                                    while gj < groups {
                                        out = buffer.push(heap, out, byte_of(','));
                                        out = buffer.append(heap, out, text[gs[2 * gj]..gs[2 * gj + 1]]);
                                        gj = gj + 1;
                                    }
                                    out = buffer.push(heap, out, byte_of(10));
                                    var p = 0;
                                    while p < m {
                                        out = curve.put_cell(heap, out, x0[p], false);
                                        gj = 0;
                                        while gj < groups {
                                            out = buffer.push(heap, out, byte_of(','));
                                            out = curve.put_cell(heap, out, cells[gj * m + p], false);
                                            gj = gj + 1;
                                        }
                                        out = buffer.push(heap, out, byte_of(10));
                                        p = p + 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, cb);
    unbox_slice(heap, x0b);
    unbox_slice(heap, gb);
    unbox_slice(heap, yb);
    unbox_slice(heap, xb);
    return (code, line, groups, out);
}
